{
    "name": "kixx-templating",
    "version": "5.0.1",
    "description": "A simple and robust markup and text templating system for JavaScript environments.",
    "type": "module",
    "exports": "./mod.js",
    "main": "./mod.js",
    "engines": {
        "node": ">=16.13.2"
    },
    "scripts": {
        "benchmark": "node ./benchmark/phase8.js",
        "benchmark:quick": "node ./benchmark/phase8.js --quick",
        "test": "node lint.js && node ./test/run-tests.js && node ./test/mustache-spec.js",
        "spec": "node ./test/mustache-spec.js",
        "spec:report": "node ./test/mustache-spec.js --report",
        "spec:update": "node ./test/mustache-spec.js --update"
    },
    "homepage": "https://www.kixx.dev/",
    "repository": {
        "type": "git",
        "url": "https://github.com/kixx-framework/kixx-templating.git"
    },
    "bugs": {
        "url": "https://github.com/kixx-framework/kixx-templating/issues"
    },
    "author": "Kris Walker (www.kriswalker.me)",
    "license": "MIT",
    "files": [
        "docs/",
        "lib/",
        "mod.js"
    ],
    "keywords": [
        "kixx",
        "templating",
        "templates"
    ]
}
